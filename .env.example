# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit real secrets.

# --- Database (SQLite) ---
# Path is relative to the `prisma/` directory (schema.prisma location).
# The repo ships with a seeded demo database at prisma/data/jobs.db
DATABASE_URL="file:./data/jobs.db"

# --- NextAuth.js ---
# Generate with: openssl rand -base64 32
# A dev-only fallback is used if unset, but production requires a real secret.
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# --- Stripe (optional — paid plan checkout) ---
# Without these, /api/billing/checkout returns 503 and the app falls back to
# simulated plan changes for the Free plan only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_ENTERPRISE=

# --- AI (optional) ---
# Without an API key the AI routes fall back to deterministic local scoring.
OPENAI_API_KEY=
